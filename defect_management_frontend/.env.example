# ------------------------------------------------------------------------------
# Defect Management Frontend (Next.js) - Environment Variables (public)
#
# All variables prefixed with NEXT_PUBLIC_ are embedded into the client bundle.
# Do not put secrets here.
#
# REQUIRED BY CURRENT FRONTEND CODE:
# - NEXT_PUBLIC_API_BASE_URL (src/lib/apiClient.ts)
# - NEXT_PUBLIC_SUPABASE_URL (src/lib/supabaseClient.ts)
# - NEXT_PUBLIC_SUPABASE_ANON_KEY (src/lib/supabaseClient.ts)
#
# NOTE:
# The container may define additional NEXT_PUBLIC_* variables for deployment/runtime
# configuration. They are included below for completeness, but many are not used by
# the current frontend code unless you wire them in.
# ------------------------------------------------------------------------------

# Backend API base URL (used by src/lib/apiClient.ts)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (used by src/lib/supabaseClient.ts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# ------------------------------------------------------------------------------
# Additional container-provided env vars (optional / currently unused by code)
# ------------------------------------------------------------------------------

# Alternate/legacy API base keys (not currently read by the frontend code)
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_BACKEND_URL=

# Frontend URL (may be useful for auth redirect configuration if added later)
NEXT_PUBLIC_FRONTEND_URL=

# WebSocket base URL (not currently used)
NEXT_PUBLIC_WS_URL=

# Runtime flags / diagnostics (not currently used)
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_ENABLE_SOURCE_MAPS=false
NEXT_PUBLIC_PORT=3000
NEXT_PUBLIC_TRUST_PROXY=false
NEXT_PUBLIC_LOG_LEVEL=info

# Healthcheck path (not currently used)
NEXT_PUBLIC_HEALTHCHECK_PATH=/health

# Feature flags (not currently used)
NEXT_PUBLIC_FEATURE_FLAGS={}
NEXT_PUBLIC_EXPERIMENTS_ENABLED=false

# Supabase alternate key name (not currently read by the frontend code)
NEXT_PUBLIC_SUPABASE_KEY=
